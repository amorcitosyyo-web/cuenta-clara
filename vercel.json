{
  "cleanUrls": true,
  "functions": {
    "api/agent.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/agent?route=$1" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/sync-email?job=email", "schedule": "0 14 * * *" },
    { "path": "/api/sync-email?job=email", "schedule": "0 17 * * *" },
    { "path": "/api/sync-email?job=email", "schedule": "0 20 * * *" },
    { "path": "/api/sync-email?job=email", "schedule": "0 2 * * *" },
    { "path": "/api/sync-email?job=due", "schedule": "0 14 * * *" },
    { "path": "/api/sync-email?job=routine", "schedule": "0 1 * * *" }
  ]
}
